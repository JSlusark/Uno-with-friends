# Runs only the test suites of the apps touched by the commits being pushed.
# git feeds one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
changed=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch, nothing to test

  if [ "$remote_sha" = "$zero" ]; then
    # new branch on the remote: compare against where it forked from main
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base=$remote_sha
  fi

  if [ -n "$base" ]; then
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  else
    # no common history to compare with: play it safe and run everything
    changed="apps/web/
apps/api/"
  fi
done

if echo "$changed" | grep -q '^apps/web/'; then
  echo "pre-push: web changed, running web tests"
  npm --prefix apps/web test
fi

if echo "$changed" | grep -q '^apps/api/'; then
  echo "pre-push: api changed, running api tests"
  npm --prefix apps/api test
fi
